{
    "name": "app/activity-log",
    "description": "Activity Log PHP Project",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "illuminate/database": "^11.0",
        "symfony/var-dumper": "^6.4",
        "nikic/fast-route": "^1.3",
        "relay/relay": "^3.0",
        "laminas/laminas-httphandlerrunner": "^2.13",
        "laminas/laminas-diactoros": "^3.8",
        "phpauth/phpauth": "^1.6"
    },
    "autoload": {
        "psr-4": {
